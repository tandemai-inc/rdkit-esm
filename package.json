    "bumpp": "^10.3.2",
    "oxfmt": "^0.41.0",
    "rolldown-plugin-wasm": "^0.2.1",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}