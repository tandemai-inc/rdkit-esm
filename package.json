{
  "name": "rdkit-esm",
  "version": "0.5.0-rc.1",
  "description": "RDKit minimal lib for the modern web.",
  "homepage": "https://github.com/tandemai/rdkit-esm#readme",
  "bugs": {
    "url": "https://github.com/tandemai/rdkit-esm/issues"
  },
  "license": "MIT",
  "author": "Paul Pillot <paul.pillot@tandemai.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tandemai/rdkit-esm.git"
  },
  "files": [
    "dist"
  ],
